<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#22D3EE</item>
        <item name="colorPrimaryDark">#070B16</item>
        <item name="colorAccent">#3B82F6</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">#070B16</item>
        <item name="android:statusBarColor">#070B16</item>
        <item name="android:navigationBarColor">#060913</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">#070B16</item>
        <item name="android:navigationBarColor">#060913</item>
    </style>
</resources>
